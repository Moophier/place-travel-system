# ============================================
# Cloudflare Pages 部署环境变量
# ============================================

# ===== 数据库 =====
# SQLite 文件路径（本地开发用）
DATABASE_URL="file:./dev.db"

# 或使用 D1（Cloudflare Serverless SQLite）
# DATABASE_URL="prisma://localhost:5336"  # 运行时会被 Cloudflare 覆盖

# ===== NextAuth =====
# 生产环境域名
NEXTAUTH_URL="https://wenji-platform.pages.dev"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"

# ===== Payment 支付（模拟模式）=====
PAYMENT_MODE="mock"  # mock | stripe | wechat | alipay
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===== Platform 平台 =====
PLATFORM_FEE_PERCENT="20"  # 平台抽佣 20%，创作者得 80%

# ===== Cloudflare 特定 =====
# 以下变量在 Cloudflare Dashboard 中配置
# CLOUDFLARE_API_TOKEN   # 用于 GitHub Actions
# CLOUDFLARE_ACCOUNT_ID  # 账户 ID
# D1_DATABASE_ID         # D1 数据库 ID（如使用）